MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password

DB_PORT=5432
DB_HOST=localhost
DB_USER=admin
DB_PASS=password
DB_NAME=attributor

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=corpora
MINIO_USE_SSL=false

# Generate a private JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=replace-this-example-with-a-private-random-secret
JWT_ISSUER=attributor
JWT_TTL=1h

REDIS_ADDR=localhost:6379
# Replace this local example password before deployment.
REDIS_PASSWORD=attributor-redis-local

# Optional overrides (defaults come from config/config.toml):
# SERVICE_PORT=8080
# CONFIG_NAME=config
