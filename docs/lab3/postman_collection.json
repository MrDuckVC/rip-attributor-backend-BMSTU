  "item": [
    {
      "name": "01 Каталог с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/corpora?query=100&page=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "corpora"
          ],
          "query": [
            {
              "key": "query",
              "value": "100"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Создание с изображением и видео",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/corpora",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "corpora"
          ]
        },
        "description": "Выберите локальные файлы. Видео должно быть коротким и вертикальным. При существующем черновике сначала получите и удалите его.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "author",
              "value": "Автор",
              "type": "text"
            },
            {
              "key": "source",
              "value": "Корпус текстов",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Демонстрация ЛР3",
              "type": "text"
            },
            {
              "key": "word_count",
              "value": "200",
              "type": "text"
            },
            {
              "key": "pron_percent",
              "value": "8.5",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "resources/media/puskin.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "resources/media/puskin.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { pm.collectionVariables.set(\"corpus_id\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
