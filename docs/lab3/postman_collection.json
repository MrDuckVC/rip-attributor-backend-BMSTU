            "{{base_url}}"
          ],
          "path": [
            "api",
            "corpora",
            "{{corpus_id}}",
            "like"
          ]
        },
        "description": "like_value=1 устанавливает лайк; 0 снимает.",
        "body": {
          "mode": "raw",
          "raw": "{\"like\": {{like_value}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
