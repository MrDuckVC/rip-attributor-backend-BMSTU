            ]
          }
        }
      ]
    },
    {
      "name": "05 Лента без ID / следующий корпус",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/corpora/feed",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "corpora",
            "feed"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{corpus_id}}",
              "disabled": true
            },
            {
              "key": "next",
              "value": "true",
              "disabled": true
            }
          ]
        },
        "description": "Для первого показа оба параметра отключены. Для следующего корпуса включить id и next=true и повторить этот же запрос."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Лайк / отмена",
      "request": {
        "method": "POST",
        "header": [
