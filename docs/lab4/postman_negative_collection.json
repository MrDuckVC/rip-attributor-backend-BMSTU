{
  "info": {
    "name": "ЛР4 — гостевые запросы и права владельца",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Переменных и автоматической подстановки нет. Адрес API: http://localhost:8080. JWT вставьте вручную после «Bearer » в Headers каждого нужного запроса. После создания замените демонстрационный ID 5 в URL на ID из ответа. Для повторной регистрации измените логин. Коллекции ЛР3 сохранены как исторические сценарии без JWT."
  },
  "item": [
    {
      "name": "01 Публикация гостем",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text",
            "disabled": true
          }
        ],
        "url": "http://localhost:8080/api/corpora/1/publication",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"Демонстрационный корпус потенциального автора\", \"word_count\": 1, \"prep_percent\": 1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Перед отправкой проверьте ID в URL: 5 — пример ID нового черновика, 1 — пример чужого корпуса."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Empty error body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
            ]
          }
        }
      ]
    },
