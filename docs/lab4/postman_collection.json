{
  "info": {
    "name": "ЛР4 — корпусы авторов: полный сценарий",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Переменных и автоматической подстановки нет. Адрес API: http://localhost:8080. JWT вставьте вручную после «Bearer » в Headers каждого нужного запроса. После создания замените демонстрационный ID 5 в URL на ID из ответа. Для повторной регистрации измените логин. Коллекции ЛР3 сохранены как исторические сценарии без JWT."
  },
  "item": [
    {
      "name": "01 Регистрация автора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/users",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"test5\", \"password\": \"test5test5\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вход автора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "http://localhost:8080/api/users/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"test5\", \"password\": \"test5test5\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Каталог с фильтром",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text",
            "disabled": false
          }
        ],
        "url": "http://localhost:8080/api/corpora?query=100&page=1",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Создать корпус с файлами",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text",
            "disabled": false
          }
        ],
        "url": "http://localhost:8080/api/corpora",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Пушкин, Евгений Онегин",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": "resources/media/puskin.png"
            },
            {
              "key": "video",
              "type": "file",
              "src": "resources/media/puskin.mp4"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Authenticated owner\",()=>pm.expect(pm.response.json().is_owner).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Получить черновик",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text",
            "disabled": false
          }
        ],
        "url": "http://localhost:8080/api/corpora/draft",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Опубликовать корпус",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer ",
            "type": "text",
            "disabled": false
          }
        ],
        "url": "http://localhost:8080/api/corpora/5/publication",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"Демонстрационный корпус потенциального автора\", \"word_count\": 200, \"prep_percent\": 8.5}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Перед отправкой проверьте ID в URL: 5 — пример ID нового черновика, 1 — пример чужого корпуса."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
