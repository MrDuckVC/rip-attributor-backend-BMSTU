                "description",
                "prep_percent",
                "word_count"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "prep_percent": {
                    "type": "number",
                    "maximum": 100,
                    "minimum": 0
                },
                "word_count": {
                    "type": "integer",
                    "maximum": 2147483647,
                    "minimum": 0
                }
            }
