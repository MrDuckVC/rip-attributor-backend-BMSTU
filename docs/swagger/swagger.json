                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "prep_percent": {
                    "type": "number"
                },
                "video_url": {
                    "type": "string"
                },
                "word_count": {
                    "type": "integer"
                }
            }
        },
