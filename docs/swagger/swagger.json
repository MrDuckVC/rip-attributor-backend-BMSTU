        "dto.LikeRequest": {
            "type": "object",
            "required": [
                "like"
            ],
            "properties": {
                "like": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ]
                }
            }
        },
        "dto.LikeResponse": {
            "type": "object",
            "properties": {
                "is_liked": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                }
            }
        },
        "dto.LoginRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "maxLength": 25
                },
                "password": {
                    "type": "string",
                    "maxLength": 72
                }
            }
        },
        "dto.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
