        "dto.RegisterUser": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "maxLength": 25
                },
                "password": {
                    "type": "string",
                    "maxLength": 72
                }
            }
